# Local settings for the backend. Copy this file to .env and fill in the values; .env is gitignored and never
# committed. On Railway, set the same names as service variables instead (project miaudow, service miaudow).
# Load it when running locally: uvicorn fieldshift.api.app:app --env-file .env

# Claude API key for the optional "explain simply" button (FR-15) and the copilot; server side only, never in the frontend.
ANTHROPIC_API_KEY=

# The copilot, POST /api/copilot (D-172): "1" turns it on (else 503); without ANTHROPIC_API_KEY it answers without a model.
FIELDSHIFT_COPILOT=

GOOGLE_CLIENT_ID=