# Local settings. Copy this file to .env and fill in the values; .env is gitignored and never
# committed. On Railway, set the same names as service variables instead (project miaudow, service miaudow).
# Load it when running the backend locally: uvicorn fieldshift.api.app:app --env-file .env
# Every variable is optional unless its comment says otherwise.

# Backend (server side only, never in the frontend)

# Claude API key for the optional "explain simply" button (FR-15) and the copilot.
ANTHROPIC_API_KEY=

# "1" turns on the "explain simply" button (POST /api/explain); needs ANTHROPIC_API_KEY.
FIELDSHIFT_EXPLAIN=

# "1" turns on the copilot, POST /api/copilot (D-172), else it answers 503; without ANTHROPIC_API_KEY it answers without a model.
FIELDSHIFT_COPILOT=

# Google sign-in client id; the account routes are on only when this and DATABASE_URL are both set.
GOOGLE_CLIENT_ID=

# PostgreSQL connection string for the account routes.
DATABASE_URL=

# Project folder that holds rules/; needed only when the package is installed outside the checkout (the Dockerfile sets it).
FIELDSHIFT_ROOT=

# Port the server listens on in the Docker image (default 8000).
PORT=

# Data pipeline (scripts/reproduce.sh)

# NASA Earthdata user token for MODIS land cover and GPM IMERG downloads.
EARTHDATA_TOKEN=

# "1" skips the GPM IMERG download stage.
FIELDSHIFT_SKIP_IMERG=

# Tests and local development

# PostgreSQL connection string for the sign-in tests; when empty they start a throwaway database with Docker.
TEST_DATABASE_URL=

# "1" runs the test that calls the real NASA POWER API.
FIELDSHIFT_LIVE=

# Backend address the frontend dev server and preview proxy /api to (default http://127.0.0.1:8000).
MIAUDOW_API=

# Python that the browser tests use to start the backend (frontend/playwright.config.ts; default: python on PATH).
PYTHON=
