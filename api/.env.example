# Copy to .env, then export securely; do not place in web/.env or commit secrets. Server-side only.
ANTHROPIC_API_KEY=
# Required, set it explicitly: a model id enabled for your Anthropic account (claude-opus-5-5 is a valid current id).
# Without both ANTHROPIC_API_KEY and ANTHROPIC_MODEL the copilot answers with the deterministic engine.
ANTHROPIC_MODEL=
# Server-side refusal fallback of the copilot; set "off" to disable.
MIAUDOW_CLAUDE_FALLBACKS=default
# Copilot rate limit per client IP: requests/seconds.
MIAUDOW_COPILOT_RATE=20/600
# Strict allow-list on your deployed instance; localhost for development only.
MIAUDOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
