{
  "name": "miaudow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Miaudow: Nghệ An rice-field decision support with NASA Earth observations, React + Vite edition",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:snapshot": "npm run build -- --mode snapshot --outDir dist-snapshot",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test e2e/journey.spec.ts",
    "check-i18n": "vitest run src/i18n",
    "e2e:shots": "playwright test e2e/visual",
    "cesium": "node scripts/copy_cesium.mjs",
    "predev": "node scripts/copy_cesium.mjs",
    "prebuild": "node scripts/copy_cesium.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/charm": "5.3.0",
    "@gsap/react": "2.1.2",
    "cesium": "1.146.0",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "rollup-plugin-license": "3.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@cesium/core": "0.1.0",
    "@cesium/engine": "26.4.0",
    "@cesium/widgets": "16.3.0"
  }
}
