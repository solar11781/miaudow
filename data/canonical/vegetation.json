 "formulas": {
  "reflectance": "rho = DN * 0.0001 + offset; offset 0 when earthsearch:boa_offset_applied is true (pixel values already offset-corrected; raster:bands still declares -0.1), -0.1 for baseline >= 04.00 without that flag, 0 for older baselines",
  "ndvi": "(B08 - B04) / (B08 + B04)",
  "evi": "2.5 * (B08 - B04) / (B08 + 6 * B04 - 7.5 * B02 + 1)",
  "ndmi": "(B08 - B11) / (B08 + B11)",
  "resampling": "B02, B04, B08 (10 m): mean of each aligned 2x2 block of DN -> 20 m; missing if any sub-pixel is nodata",
  "undefined": "an index is undefined (not computed) where its denominator <= 0",
  "composite": "per-pixel median of the season's used scene NDVI; median/p25/p75 then taken over the district",
  "web_png": "composite reprojected to EPSG:4326 with average resampling (<= 1024 px), ramp NDVI <= 0.0 #B5623E, 0.4 #E9BC57, >= 0.8 #2F5A37 (linear in sRGB), transparent outside the district or where no valid pixel; water (river, ponds, flooded paddies) has NDVI <= 0 and shares the terracotta colour of bare soil"
 },
